# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://famdxoardiibonghxepl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_f30-BP_uq_THWHQzDpVb0A_j0u6HGpO

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import into a Client
# Component. Bypasses RLS entirely — used only by src/lib/supabase/admin.ts
# for the handful of operations that must run outside a user's own RLS
# context (e.g. reading the auto-approve sweep's own service actions).
# Get this from the Supabase dashboard: Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY. Optional — only needed once a real IntaSend/Kora account is
# connected via /admin/integrations. See
# docs/16-payment-verification-integrations.md. Unset by default: every
# webhook fails signature verification and every outbound call returns a
# clear "not configured" error until these are set — never a silent
# false positive.
INTASEND_ENV=sandbox
INTASEND_SECRET_KEY=
INTASEND_PUBLIC_KEY=
# The "challenge" string you set when configuring the webhook endpoint in
# the IntaSend dashboard — see https://developers.intasend.com/docs/webhooks.
INTASEND_WEBHOOK_CHALLENGE=
KORA_SECRET_KEY=

# SERVER ONLY. Optional — only needed once a real Pesapal account is
# connected via /admin/integrations. Same "unset = clear not-configured
# error, never a silent false positive" rule as IntaSend above.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# From the one-time RegisterIPN call against Pesapal's API — see
# docs/16-payment-verification-integrations.md.
PESAPAL_IPN_ID=
# Where Pesapal redirects the customer's browser back to after checkout
# (e.g. https://yourapp.example/account/bookings).
PESAPAL_CALLBACK_URL=

# SERVER ONLY. Required for /api/cron/auto-approve-sweep to accept
# requests at all — that route fails closed (401/503) without a real
# value here. Vercel automatically sends this as
# `Authorization: Bearer <value>` on its own Cron invocations once both
# this env var AND the vercel.json cron entry are deployed — set a random
# string of 16+ characters in the Vercel dashboard (Project Settings >
# Environment Variables), it is never generated or read anywhere else in
# this codebase. See https://vercel.com/docs/cron-jobs/manage-cron-jobs.
CRON_SECRET=

# SERVER ONLY. Optional — src/lib/alerts.ts's sendOpsAlert() only sends
# when all three of these are set; otherwise it logs and no-ops (never
# blocks the check that called it). Used today by
# /api/cron/ledger-reconciliation to page someone on a real ledger
# imbalance or a reconciliation-job failure — see MARKETPLACE_REMEDIATION_
# REGISTER.md PAY-006. Requires a Resend account with a verified sending
# domain; ALERT_EMAIL_FROM must be an address on that verified domain.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# SERVER ONLY. Customer-support system (MARKETPLACE_SUPPORT_SYSTEM_PLAN.md).
# Provider-agnostic by design — see src/lib/notifications/: nothing in the
# support system hardcodes a vendor, it dispatches through whichever channel
# is active in the notification_channels table (switch via /admin/integrations
# > Support Channels). RESEND_API_KEY above is reused as the Resend adapter's
# credential; these two are specific to the support system:
#   RESEND_WEBHOOK_SECRET — the "whsec_..." signing secret from the Resend
#     dashboard's Webhooks page for the inbound email.received webhook,
#     verified via Svix HMAC in src/lib/notifications/adapters/resend-email.ts.
#     Without it, every inbound webhook is rejected (fails closed, never
#     trusts an unverified payload).
#   SUPPORT_EMAIL_FROM — the address auto-acknowledgements and agent replies
#     are sent from (e.g. support@yourdomain.com). Must be on a domain
#     verified with whichever email channel is currently active. Without it,
#     sendSupportAutoAck/sendSupportAgentReplyEmail return "not configured"
#     rather than sending.
RESEND_WEBHOOK_SECRET=
SUPPORT_EMAIL_FROM=
